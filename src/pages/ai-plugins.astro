---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { aiPlugins } from '../lib/ai-plugins';
---

<BaseLayout title="AI plugins" description="Six open-source projects by Eric Hare that bring real tools, native skills, and inspectable workflows to Claude and Codex.">
  <PageHeader eyebrow="AI plugins" title="Real tools. Right inside your agent." lede="I build open-source plugins that connect Claude and Codex to the work itself: live databases, unfamiliar code, skill libraries, website audits, property records, and forensic evidence." />

  <section class="container-wide integration-strip" aria-label="Integration approach">
    <div class="host-pair"><span>Claude Code</span><span aria-hidden="true">↔</span><span>Codex</span></div>
    <p>Six projects. Two native plugin hosts. Shared capabilities, with installation and presentation adapted to each client.</p>
    <a href="#plugins">Explore the collection ↓</a>
  </section>

  <Section eyebrow="Inside the integration" title="More than a prompt." subtitle="The useful part is how the pieces work together. Each project packages the capabilities its workflow needs.">
    <div class="integration-grid">
      <article><span class="step">01 / TOOLS</span><h3>Reach real systems.</h3><p>MCP gives an agent callable operations and structured results, from a local skill catalog to a live database.</p></article>
      <article><span class="step">02 / SKILLS</span><h3>Carry the workflow.</h3><p>Native skills guide the agent through setup, useful starting points, and the evidence it needs to check.</p></article>
      <article><span class="step">03 / REVIEW</span><h3>Keep the work inspectable.</h3><p>Citations, confirmation gates, source evidence, and portable reports make results easier to examine and challenge.</p></article>
    </div>
  </Section>

  <Section id="plugins" eyebrow="The collection" title="Choose a project. Bring your agent." subtitle="Each project below has a published installation route for both Claude Code and Codex. Open its installation panel for the exact community marketplace commands.">
    <div class="plugin-grid">
      {aiPlugins.map((plugin) => (
        <article class="plugin-card" id={plugin.id}>
          <header><img src={plugin.icon} alt="" width="72" height="72" loading="lazy" /><div><p class="eyebrow">{plugin.category}</p><h3>{plugin.name}</h3></div></header>
          <p class="summary">{plugin.summary}</p>
          <div class="host-badges" aria-label="Native plugin support"><span>Claude Code</span><span>Codex</span></div>
          <p class="integration">{plugin.integration}</p>
          <ul class="capabilities">{plugin.capabilities.map((capability) => <li>{capability}</li>)}</ul>
          <p class="requirements">{plugin.requirement}</p>
          <div class="project-links"><a href={plugin.docs}>Documentation ↗</a><a href={plugin.repository}>GitHub ↗</a><a href={plugin.release}>{plugin.status} ↗</a></div>
          <details class="install">
            <summary>Install {plugin.name}</summary>
            <div class="install-content">
              <p>Run in your terminal with a current client that supports plugins.</p>
              <h4>Claude Code</h4><pre><code>{plugin.claude}</code></pre>
              <h4>Codex</h4><pre><code>{plugin.codex}</code></pre>
              <p>{plugin.installNote}</p>
              <p>Reopen your agent after installation. Review the project's privacy and setup documentation before connecting data.</p>
            </div>
          </details>
        </article>
      ))}
    </div>
  </Section>

  <Section eyebrow="Open by design" title="Try the work. Inspect the source.">
    <div class="closing">
      <p>These links point to publisher-maintained repositories, release packages, and community marketplaces. A working plugin or submitted review is separate from approval in an official directory. Claude, Codex, and vendor names identify compatibility; they do not imply endorsement.</p>
      <p>Most of this work comes from <a href="https://jestats.io">JEStats</a>, my consulting practice. Verity grows out of my <a href="/phd">research in statistical forensics</a>. All six projects are open source, with their setup requirements and limitations available for review.</p>
      <a class="work-link" href="/projects">Explore the rest of my work →</a>
    </div>
  </Section>
</BaseLayout>

<style>
  .integration-strip { display:grid; grid-template-columns:1fr 1.2fr auto; gap:2rem; align-items:center; padding-block:1.7rem; border-block:1px solid var(--color-border-muted); }
  .host-pair { display:flex; gap:.8rem; align-items:center; font-size:1.1rem; font-weight:650; }
  .host-pair span:nth-child(2) { color:var(--color-accent); }
  .integration-strip p { color:var(--color-fg-muted); font-size:.94rem; line-height:1.65; }
  .integration-strip>a,.work-link { color:var(--color-accent); font-weight:600; font-size:.95rem; }
  .integration-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:2rem; }
  .step { color:var(--color-accent); font-size:.72rem; letter-spacing:.08em; font-family:var(--font-mono); }
  .integration-grid h3 { font-size:1.55rem; margin:.9rem 0 .7rem; }
  .integration-grid p { color:var(--color-fg-muted); line-height:1.75; }
  .plugin-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.5rem; align-items:start; }
  .plugin-card { min-width:0; padding:clamp(1.3rem,3vw,2rem); border:1px solid var(--color-border-muted); border-radius:var(--radius-xl); background:var(--color-surface); scroll-margin-top:6rem; }
  .plugin-card header { display:flex; gap:1.1rem; align-items:center; }
  .plugin-card header img { width:4.5rem; height:4.5rem; object-fit:contain; flex:none; border-radius:1rem; }
  .plugin-card h3 { font-size:clamp(1.55rem,2.7vw,2rem); line-height:1.2; margin-top:.4rem; }
  .plugin-card .eyebrow { font-size:.65rem; }
  .summary { font-size:1.05rem; line-height:1.75; margin-top:1.4rem; }
  .host-badges { display:flex; gap:.5rem; margin:1.2rem 0; }
  .host-badges span { border:1px solid var(--color-border-muted); border-radius:2rem; padding:.25rem .7rem; font-size:.74rem; font-weight:600; }
  .integration { color:var(--color-fg-muted); line-height:1.75; font-size:.94rem; }
  .capabilities { display:flex; flex-wrap:wrap; gap:.4rem .9rem; list-style:none; padding:0; margin:1.1rem 0; color:var(--color-accent); font-size:.76rem; }
  .requirements { color:var(--color-fg-muted); font-size:.8rem; line-height:1.7; border-top:1px solid var(--color-border-muted); padding-top:1.1rem; }
  .project-links { display:flex; flex-wrap:wrap; gap:.75rem 1.2rem; margin:1.3rem 0; font-size:.83rem; color:var(--color-accent); }
  .project-links a:last-child { flex-basis:100%; color:var(--color-fg-muted); font-size:.75rem; }
  a:hover { text-decoration:underline; text-underline-offset:.25em; }
  .install { border-top:1px solid var(--color-border-muted); padding-top:1.1rem; }
  .install summary { cursor:pointer; font-weight:600; font-size:.9rem; color:var(--color-accent); }
  .install-content { padding-top:1rem; }
  .install-content p { font-size:.83rem; color:var(--color-fg-muted); line-height:1.7; margin:.8rem 0; }
  .install h4 { font-size:.9rem; margin:1rem 0 .5rem; }
  .install pre { max-width:100%; overflow-x:auto; padding:1rem; border-radius:.5rem; background:var(--color-bg); border:1px solid var(--color-border-muted); font-size:.72rem; line-height:1.7; }
  .closing { max-width:48rem; }
  .closing p { color:var(--color-fg-muted); line-height:1.85; margin-bottom:1.3rem; }
  .closing a { color:var(--color-accent); }
  @media(max-width:900px) { .integration-strip { grid-template-columns:1fr; gap:1rem; } .integration-grid { gap:1.4rem; } }
  @media(max-width:700px) { .plugin-grid,.integration-grid { grid-template-columns:1fr; } .integration-grid article+article { border-top:1px solid var(--color-border-muted); padding-top:1.4rem; } }
</style>
